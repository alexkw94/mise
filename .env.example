# Server-side only. Never prefix with NEXT_PUBLIC_ — the key must not reach the browser.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Defaults to claude-haiku-4-5 (the brief's cost choice for the
# nutrition + suggestion calls). Bump to claude-sonnet-5 if estimates feel weak.
ANTHROPIC_MODEL=claude-haiku-4-5

# UploadThing — nur serverseitig, niemals mit NEXT_PUBLIC_ Prefix.
UPLOADTHING_TOKEN=

# Erlaubte Herkunft für Uploads (die Adresse der App).
NEXT_PUBLIC_SITE_ORIGIN=http://localhost:3001
